{
  "permissions": {
    "deny": [
      "Edit(./armv4t.circ)",
      "Write(./armv4t.circ)",
      "Edit(./armv4t_2.circ)",
      "Write(./armv4t_2.circ)",
      "Edit(./.claude/hooks/protect_files.py)",
      "Write(./.claude/hooks/protect_files.py)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./tools/audit.py)",
      "Write(./tools/audit.py)",
      "Edit(./.audit/ledger.jsonl)",
      "Write(./.audit/ledger.jsonl)",
      "Read(~/.config/customcpu/audit.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/audit_log.py"
          }
        ]
      }
    ]
  }
}
